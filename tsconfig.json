{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/plugin/**/*.ts",
    "scripts/live.ts",
    "scripts/live-memory.ts",
    "scripts/live-manage.ts",
    "scripts/eval-memory.ts",
    "scripts/doctor.ts",
    "scripts/live-fork.ts"
  ]
}
